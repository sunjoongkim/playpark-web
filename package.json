{
  "name": "playpark-homepage",
  "version": "1.0.0",
  "description": "PlayPark 마케팅 웹사이트 — Tailwind CSS(PostCSS 빌드) 기반 정적 HTML 사이트",
  "private": true,
  "scripts": {
    "build": "postcss src/css/main.css -o dist/output.css --env production",
    "watch": "postcss src/css/main.css -o dist/output.css --watch",
    "dev": "concurrently -k \"npm:watch\" \"serve -l 3000 .\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "serve": "^14.2.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0"
  }
}
